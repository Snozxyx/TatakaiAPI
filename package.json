{
  "name": "@tatakai/api-v3",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "Tatakai V6 catalog API — AniList/Jikan metadata, extensions manifests, telemetry. No scraping.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "job:ingest": "tsx src/jobs/ingestionWorker.ts",
    "job:feeds": "tsx src/jobs/contentRefresh.ts",
    "job:mappings": "tsx src/jobs/mappingsRefresh.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.2",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.5.0",
    "envalid": "^8.0.0",
    "hono": "^4.7.10",
    "ioredis": "^5.6.1",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
