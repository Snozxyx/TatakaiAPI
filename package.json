{
    "name": "tatakapi",
    "version": "5.0.0",
    "description": "NodeJS API for obtaining anime data from hianimez.to",
    "main": "dist/src/server.js",
    "type": "module",
    "scripts": {
        "start": "node dist/src/server.js",
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "buildnstart": "tsc && node dist/src/server.js",
        "vercel-build": "echo hello",
        "prepare": "node .husky/install.mjs",
        "test": "vitest run --config vitest.config.ts",
        "healthcheck": "curl -f https://api.tatakai.me:4000/health",
        "typecheck": "tsc --noEmit",
        "format": "prettier --cache --write .",
        "format:check": "prettier --cache --check ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/snozxyx/tatakaiapi.git"
    },
    "bugs": {
        "url": "https://github.com/snozxyx/tatakaiapi/issues"
    },
    "homepage": "https://github.com/snozxyx/tatakaiapi#readme",
    "keywords": [
        "anime",
        "weeb",
        "scraper",
        "zoro.to",
        "aniwatch.to",
        "hianime.to",
        "hianimez.to"
    ],
    "license": "MIT",
    "dependencies": {
        "@hono/node-server": "^1.14.2",
        "@types/pg": "^8.20.0",
        "axios": "^1.7.9",
        "cheerio": "1.0.0",
        "crypto-js": "^4.2.0",
        "dotenv": "^16.5.0",
        "envalid": "^8.0.0",
        "hono": "^4.7.10",
        "hono-rate-limiter": "^0.4.2",
        "https-proxy-agent": "^9.0.0",
        "ioredis": "^5.6.1",
        "pg": "^8.20.0",
        "pino": "^9.7.0",
        "pino-pretty": "^13.0.0",
        "puppeteer-real-browser": "^1.3.18",
        "string-similarity": "^4.0.4"
    },
    "devDependencies": {
        "@types/node": "^22.15.21",
        "husky": "^9.1.7",
        "prettier": "^3.5.3",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3",
        "vitest": "^4.1.8"
    }
}
